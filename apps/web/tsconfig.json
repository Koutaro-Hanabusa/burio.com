{
	"extends": "./.void/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["void/env", "vite/client", "node"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": [
		"src/pages",
		"src/server",
		"src/routes/api/blog/[id]/views.ts",
		"src/routes/api/og/blog/[id].ts",
		"src/routes/api/ogp.ts",
		"src/routes/og/blog/[id].ts",
		"src/routes/r2/images/[filename].ts",
		"src/routes/upload/image.ts",
		"src/env.ts",
		"src/bindings.d.ts",
		"vite.config.ts",
		"void.config.ts"
	],
	"exclude": ["vitest.config.ts"]
}
