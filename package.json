{
	"name": "burio.com",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"check": "vp lint --fix && vp fmt",
		"prepare": "vp config",
		"dev": "vp run --filter web dev",
		"build": "vp run --filter web build",
		"test": "vp run --filter web test",
		"check-types": "vp run --filter web check-types",
		"dev:web": "vp run --filter web dev",
		"db:studio": "vp run --filter web db:studio",
		"db:generate": "vp run --filter web db:generate",
		"r2:upload": "bun run scripts/r2-uploader.js upload",
		"r2:list": "bun run scripts/r2-uploader.js list",
		"r2:delete": "bun run scripts/r2-uploader.js delete"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1064.0",
		"@paralleldrive/cuid2": "^2.3.1",
		"@types/three": "^0.180.0"
	},
	"devDependencies": {
		"vite-plus": "1.3.0"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0"
	}
}
