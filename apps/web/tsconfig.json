{
	"extends": "./.void/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["void/env", "vite/client", "node"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": [
		"src/pages",
		"src/server",
		"src/env.ts",
		"src/bindings.d.ts",
		"vite.config.ts",
		"void.config.ts"
	],
	"exclude": ["vitest.config.ts"]
}
