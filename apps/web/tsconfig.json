{
	"extends": "./.void/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["void/env", "vite/client", "node"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "vite.config.ts", "void.config.ts", "drizzle.config.ts"],
	"exclude": ["vitest.config.ts"]
}
